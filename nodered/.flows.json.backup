    {
        "id": "64662bfed63f78eb",
        "type": "function",
        "z": "e2dbc21dd8e66fa3",
        "name": "function 1",
        "func": "let data = (typeof msg.payload === \"string\") ? JSON.parse(msg.payload) : msg.payload;\n\nlet influxPayload = [\n    {\n        measurement: \"capteurs\",\n        tags: {\n            device: msg.topic.split(\"/\").pop()\n        },\n        fields: {\n            temperature: parseFloat(data.temperature),\n            humidity: parseFloat(data.humidity),\n            light: parseFloat(data.light)\n        },\n        timestamp: new Date().toISOString()\n    }\n];\n\n// Message pour InfluxDB\nlet influxMsg = { ...msg };\ninfluxMsg.payload = influxPayload;\n\n// Message pour Meshview\nlet meshMsg = {\n    topic: \"msh/CO/cajica/\" + msg.topic.split(\"/\").pop(),\n    payload: JSON.stringify({\n        from: msg.topic.split(\"/\").pop(),\n        lat: data.lat || 4.918,\n        lon: data.lon || -74.027,\n        temperature: data.temperature,\n        humidity: data.humidity,\n        light: data.light,\n        batteryLevel: data.battery || 3.9,\n        snr: data.snr || 12.5,\n        time: new Date().toISOString()\n    })\n};\n\nreturn [influxMsg, meshMsg]; // Deux sorties\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
